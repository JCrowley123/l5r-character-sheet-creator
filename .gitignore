# Throwaway test harnesses and mock-ups. These are regenerated on demand by
# make_device_harness.py, so there is no reason to store them.
_device_harness.html
_mockup_*.html
_off.css
_off.js
_skel.txt

# Python leftovers
__pycache__/
*.pyc

# OS clutter
Thumbs.db
desktop.ini
.DS_Store

# Sourcebook PDFs -- the user's own reference copies, kept local only.
# Several exceed GitHub's 100MB hard push limit, and the full set is well
# past the 1GB free Git LFS quota. Phase 13 of the roadmap will load these
# client-side (IndexedDB) rather than from git, so tracking them here was
# never architecturally necessary -- OneDrive backs up this folder on its
# own, independent of git.
L5R 4th edition books/

# Deploy output (Phase 0.5). Cloudflare Pages rebuilds this from source on every
# push, so committing it would only create a second copy to drift out of step.
dist/

# Playwright, installed on demand to run the Phase 0.6 QA harnesses. Nothing the
# app ships depends on it -- the sheet itself still has no build system and no
# dependencies -- so it belongs in a throwaway install, not in the repo.
node_modules/
package-lock.json

# Phase 0.7's staged Android web assets. build/build_android.py regenerates this
# from dist/ on every build, and it holds a second copy of the 1.4MB page --
# committing it would store the sheet twice and let the copies drift.
Versions/Part F — Cross-Platform Delivery/PART F — Phase 0.7 Native Android App/app/www/

# The decrypted release keystore, if one is ever written here by mistake.
# Only release.keystore.enc belongs in the repo; the plaintext never does.
*.keystore
!*.keystore.enc
